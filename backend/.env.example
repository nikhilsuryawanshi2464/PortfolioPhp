# Server Configuration
NODE_ENV=development
PORT=5001
API_VERSION=v1

# MongoDB Atlas URI — replace with your own
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Configuration — change these to random strings in production!
JWT_SECRET=change_me_to_a_random_secret_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_to_another_random_string
JWT_REFRESH_EXPIRE=30d

# Cloudinary — get free account at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Keep EMAIL_FROM as the authenticated Gmail sender.
EMAIL_FROM=your@gmail.com
# Prefer a different mailbox or alias here if you want Gmail to treat notifications as incoming mail.
ADMIN_EMAIL=admin-notify@example.com

# GitHub — optional, prevents rate limiting
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=yourgithubusername

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_EMAIL_NOTIFICATIONS=false

# ── KEEPALIVE SERVICE ──────────────────────────────────────────────────────────
# Your deployed backend URL — used by keepalive for HTTP self-ping
# Set this in Vercel → Project → Settings → Environment Variables
BACKEND_URL=https://your-backend.vercel.app
